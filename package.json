{
  "name": "i-am-Nyaacho shizuku",
  "version": "1.0.7",
  "description": "Plugin for DeepSeek Harness that ships the 猫娘 Nyaacho shizuku persona preset (persona-owning system prompt with the skill toolchain trimmed): declared as a @deepseek-ai/dsh-agent-preset composition row on dsh >=0.1.7, deployed from template/ to ~/.dsh/.agent-presets/Nyaacho shizuku/ on 0.1.6 hosts.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "dsh-plugin",
    "preset",
    "persona",
    "Nyaacho shizuku"
  ],
  "license": "MIT",
  "author": "Tkingxiao",
  "engines": {
    "dsh": "0.1.6-alpha.1 || 0.1.6-alpha.2 || 0.1.7-alpha.1 || 0.1.7-alpha.2 || 0.1.7-rc.1 || 0.1.7-rc.2 || 0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-alpha.1 || >=0.1.7-alpha.1"
  },
  "homepage": "https://github.com/Tkingxiao/I-am-Nyaacho shizuku#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tkingxiao/I-am-Nyaacho shizuku.git"
  },
  "bugs": {
    "url": "https://github.com/Tkingxiao/I-am-Nyaacho shizuku/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "main": "lib/index.js",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "template"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": "0.1.6-alpha.1 || 0.1.6-alpha.2 || 0.1.7-alpha.1 || 0.1.7-alpha.2 || 0.1.7-rc.1 || 0.1.7-rc.2 || 0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-alpha.1 || >=0.1.7-alpha.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "immediately": true
    }
  }
}
